{
  "permissions": {
    "allow": [
      "Bash(curl -s --max-time 8 http://localhost:8700/api/health)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(git:*)",
      "Bash(curl -s \"http://localhost:8700/api/search?q=roadmap+next+todo+outstanding&limit=5&content_type=history\")",
      "Bash(python -m pytest tests/ --affected --cap 40 -x -q)",
      "Bash(python -m pytest tests/ -k \"neoncity or neon_city or cyberspace or world_sim\" -x -q)",
      "Bash(python -m pytest tests/test_cyberspace.py -x -q)",
      "Bash(python -m pytest tests/ --smoke-only -q)",
      "Bash(python scripts/smart_test.py --smoke)",
      "Bash(python:*)",
      "Bash(find /c/Files/Models/CosySim/engine/api -name *.py)",
      "Bash(grep -r \"visual.*editor\\\\|scene.*editor\\\\|visual.*creation\\\\|visual.*builder\" /c/Files/Models/CosySim/content/scenes --include=*.py --include=*.js --include=*.html)",
      "Bash(find /c/Files/Models/CosySim -name *notebook* -o -name *editor* -o -name *visual*)",
      "Bash(wc:*)",
      "Bash(npm install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -er .tool_input.command | grep -q 'git commit' && git diff --cached --stat 2>/dev/null && git diff --stat 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking commit diff..."
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}

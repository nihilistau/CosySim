{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "python",
        "args": ["engine/nexus/nexus_session_logger.py", "start"],
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "python",
        "args": ["engine/nexus/nexus_session_logger.py", "end"],
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "python",
        "args": ["engine/nexus/nexus_session_logger.py", "prompt"],
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}

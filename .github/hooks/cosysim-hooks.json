{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "pwsh -File .github/hooks/scripts/log-session.ps1",
        "bash": "mkdir -p .github/hooks/logs && echo \"[HOOK] sessionStart at $(date -Iseconds)\" >> .github/hooks/logs/session.log",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "powershell": "pwsh -File .github/hooks/scripts/log-session.ps1",
        "bash": "echo \"[HOOK] sessionEnd at $(date -Iseconds)\" >> .github/hooks/logs/session.log",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "powershell": "pwsh -File .github/hooks/scripts/log-tool-usage.ps1",
        "bash": "mkdir -p .github/hooks/logs && cat | jq -c '{toolName: .toolName, timestamp: .timestamp}' >> .github/hooks/logs/tools.jsonl",
        "timeoutSec": 3
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "powershell": "pwsh -File .github/hooks/scripts/check-tool-safety.ps1",
        "bash": "data=$(cat); tool=$(echo $data | jq -r '.toolName'); case $tool in *delete*|*remove*|*drop*|*destroy*|*purge*|*truncate*) echo '{\"decision\": \"deny\", \"reason\": \"Destructive operations require manual approval\"}';; *) echo '{\"decision\": \"approve\"}';; esac",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "powershell": "pwsh -File .github/hooks/scripts/log-errors.ps1",
        "bash": "mkdir -p .github/hooks/logs && cat | jq -c '{error: .error, toolName: .toolName, timestamp: .timestamp}' >> .github/hooks/logs/errors.jsonl",
        "timeoutSec": 3
      }
    ]
  }
}

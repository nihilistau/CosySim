{
  "id": "template_character_viewer",
  "name": "Character Viewer Template",
  "scene_key": "character_viewer",
  "accent_color": "#8b5cf6",
  "description": "Character profile viewer with portrait, stats, inventory, relationship tracker, and memory log.",
  "components": [
    {
      "id": "header_1",
      "type": "scene_header",
      "props": { "title": "CHARACTER", "subtitle": "Profile & Stats", "show_clock": false, "show_credits": false },
      "children": {}
    },
    {
      "id": "main_layout",
      "type": "column_layout",
      "props": { "columns": 2, "ratio": "1:2" },
      "children": {
        "left": [
          { "id": "portrait", "type": "portrait_frame", "props": { "size": "large" }, "children": {} },
          { "id": "mood", "type": "status_indicator", "props": { "label": "Mood", "value": "Neutral", "status": "ok" }, "children": {} },
          { "id": "energy_bar", "type": "health_bar", "props": { "label": "Energy", "value": 80 }, "children": {} },
          { "id": "relationship", "type": "health_bar", "props": { "label": "Trust", "value": 45 }, "children": {} }
        ],
        "right": [
          { "id": "tabs", "type": "tab_bar", "props": { "tabs": ["Profile", "Inventory", "Memories", "Skills"] }, "children": {} },
          { "id": "profile_panel", "type": "glass_panel", "props": { "title": "Profile", "variant": "default", "scrollable": true }, "children": {} },
          { "id": "inventory_grid", "type": "inventory_grid", "props": { "columns": 4, "show_prices": false, "selectable": true }, "children": {} }
        ]
      }
    }
  ],
  "updated_at": "2026-03-22T00:00:00Z"
}

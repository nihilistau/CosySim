{
  "manifest_version": 3,
  "name": "Send to Nexus",
  "version": "1.0.0",
  "description": "Right-click any link or selected text to send it to your Nexus Knowledge Management System",
  "permissions": ["contextMenus", "activeTab", "notifications", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
